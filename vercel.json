{
  "version": 2,
  "builds": [
    {
      "src": "dist/backend/main.js",
      "use": "@vercel/node"
    },
    {
      "src": "dist/frontend/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/dist/backend/main.js"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/dist/frontend/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
