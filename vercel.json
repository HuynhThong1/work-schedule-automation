{
  "version": 2,
  "builds": [
    {
      "src": "dist/backend/main.js",
      "use": "@vercel/node"
    },
    {
      "src": "dist/frontend/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/dist/backend/main.js"
    },
    {
      "src": "/(.*\\.(js|css|ico|svg|woff|woff2|ttf|eot|png|jpg|jpeg|gif|txt))",
      "dest": "/dist/frontend/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/frontend/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
