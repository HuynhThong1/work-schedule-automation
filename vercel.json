{
  "version": 2,
  "builds": [
    {
      "src": "dist/backend/main.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/dist/backend/main.js"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/frontend/$1"
    }
  ],
  "env": {
    "MONGODB_URI": "@mongodb_uri",
    "JWT_SECRET": "@jwt_secret",
    "NODE_ENV": "production"
  },
  "outputDirectory": "dist"
}
